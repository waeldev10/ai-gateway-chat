APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_gateway_chat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI connection name from config/ai.php (openai, openai-responses, anthropic,
# gemini, deepseek, opencode, glm, kimi, openrouter, ollama, qwen, llama, grok).
AI_CONNECTION=openai

# Supported protocol drivers: chat-completions, responses, anthropic-messages,
# gemini-interactions. Every connection accepts its own <PREFIX>_DRIVER value;
# there is no global driver override.
#
# OpenAI supports both protocols. Use openai with OPENAI_DRIVER=responses to
# switch the default OpenAI connection to the Responses API.
OPENAI_DRIVER=chat-completions
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_RESPONSES_DRIVER=responses
OPENAI_RESPONSES_MODEL=
OPENAI_TIMEOUT=60

# Anthropic Messages API
ANTHROPIC_DRIVER=anthropic-messages
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT=60

# Google Gemini API (Interactions API)
GEMINI_DRIVER=gemini-interactions
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=
GEMINI_TIMEOUT=60

# DeepSeek (OpenAI Chat Completions compatible)
DEEPSEEK_DRIVER=chat-completions
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT=60

# OpenCode Console / Zen (OpenAI Chat Completions compatible endpoint)
# The local `opencode serve` API is an agent API, not a chat completion API.
OPENCODE_DRIVER=chat-completions
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_MODEL=
OPENCODE_TIMEOUT=60

# GLM / Z.AI (OpenAI Chat Completions compatible)
GLM_DRIVER=chat-completions
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=
GLM_TIMEOUT=60

# Kimi / Moonshot (OpenAI Chat Completions compatible)
KIMI_DRIVER=chat-completions
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=
KIMI_TIMEOUT=60

# OpenRouter (OpenAI Chat Completions compatible)
OPENROUTER_DRIVER=chat-completions
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT=60

# Ollama (OpenAI Chat Completions compatible; the API key is ignored by Ollama)
OLLAMA_DRIVER=chat-completions
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT=60

# Alibaba / Qwen through the DashScope OpenAI-compatible endpoint
QWEN_DRIVER=chat-completions
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
QWEN_TIMEOUT=60

# Meta Llama hosted API (OpenAI Chat Completions compatible /compat/v1 surface).
# Point LLAMA_BASE_URL at Ollama or OpenRouter to use Llama models elsewhere.
LLAMA_DRIVER=chat-completions
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.llama.com/compat/v1
LLAMA_MODEL=
LLAMA_TIMEOUT=60

# Grok / xAI (OpenAI Chat Completions compatible)
GROK_DRIVER=chat-completions
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=
GROK_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
